# Copy to backend/.env for local development. In production set these in the
# hosting provider's environment settings. Never commit real values.

# development | production
ENVIRONMENT=development

# MongoDB Atlas connection string for a dedicated, least-privilege database user
# (readWrite on the pantrypilot_ai database only).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=pantrypilot_ai

# Google AI Studio key (server-side only; never put this in the Flutter app).
GEMINI_API_KEY=your-gemini-api-key
# Tried in order; overloaded or rate-limited models fall through to the next.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# At least 32 random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7

# Only needed for the Flutter *web* build (comma-separated origins).
CORS_ORIGINS=

MAX_UPLOAD_MB=10
